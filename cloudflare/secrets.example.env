# Copy to cloudflare/.secrets.env (gitignored) and fill in. Read by deploy.sh.

# Admin console users (/admin). JSON array — use strong, new passwords.
ADMIN_USERS='[{"username":"admin","password":"CHANGE-ME"},{"username":"ranjan","password":"CHANGE-ME-TOO"}]'

# HMAC key for admin + intern sessions. Leave empty: deploy.sh generates one and
# saves it here. Changing it signs everyone out.
SESSION_SECRET=
